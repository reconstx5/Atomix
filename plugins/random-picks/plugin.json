{
  "id": "random-picks",
  "name": "Random picks",
  "version": "1.0.0",
  "description": "Adds a home-screen row of things you haven't watched yet, shuffled every visit, plus a /surprise API endpoint. A small example of home rows and plugin routes.",
  "author": "NodeFlix",
  "main": "index.js",
  "settings": [
    { "key": "title", "label": "Row title", "type": "text", "default": "Something different" },
    { "key": "count", "label": "How many items", "type": "number", "default": 16 },
    {
      "key": "kinds",
      "label": "Include",
      "type": "select",
      "default": "both",
      "options": [
        { "value": "both", "label": "Movies and shows" },
        { "value": "movie", "label": "Movies only" },
        { "value": "show", "label": "Shows only" }
      ]
    }
  ]
}
