# Copy to .env and edit. Used by docker-compose.yml.
ATOMIX_DOMAIN=media.example.com
ATOMIX_TRUST_PROXY=true
ATOMIX_PORT=8787
MEDIA_MOVIES=/srv/media/movies
MEDIA_TV=/srv/media/tv
MEDIA_MUSIC=/srv/media/music
TMDB_API_KEY=
# Optional: names/addresses phones use for Atomix's own HTTPS certificate (comma-separated), e.g. mypc.local,192.168.1.20
ATOMIX_HTTPS_NAMES=
TZ=Pacific/Auckland
